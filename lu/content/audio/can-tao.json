  {
   "text": "Mọi thứ lớn lên, đổi thay thế nào nhỉ?",
   "lang": "vi"
  },
  {
   "text": "Chuyện hạt giống bay đi.",
   "lang": "vi"
  },
  {
   "text": "Bà cất hạt giống trong túi.",
   "lang": "vi"
  },
  {
   "text": "Chuyện gà con lạc mẹ.",
   "lang": "vi"
  },
  {
   "text": "Đúng rồi! Gà con về với mẹ rồi.",
   "lang": "vi"
  },
  {
   "text": "Mono nhìn xa tìm gà con.",
   "lang": "vi"
  },
  {
   "text": "Gà con gặp lại gà mẹ.",
   "lang": "vi"
  },
  {
   "text": "Chuyện đêm lễ hội.",
   "lang": "vi"
  },
  {
   "text": "Tuyệt vời! Bé kể đủ bốn tranh rồi.",
   "lang": "vi"
  },
  {
   "text": "Mono treo đèn lồng.",
   "lang": "vi"
  },
  {
   "text": "Pháo hoa nở trên trời.",
   "lang": "vi"
  },
  {
   "text": "Mono buồn ngủ rồi.",
   "lang": "vi"
  },
  {
   "text": "Mono ngủ say.",
   "lang": "vi"
  },
  {
   "text": "Tuyệt vời! Bé biết mọi thứ lớn lên, đổi thay thế nào rồi.",
   "lang": "vi"
  },
  {
   "text": "Hạt đậu lớn lên.",
   "lang": "vi"
  },
  {
   "text": "Gà con lớn lên.",
   "lang": "vi"
  },
  {
   "text": "Giỏi quá! Gà con lớn lên từ quả trứng.",
   "lang": "vi"
  },
  {
   "text": "Gà mẹ ấp quả trứng.",
   "lang": "vi"
  },
  {
   "text": "Gà con lớn thành gà mái.",
   "lang": "vi"
  },
  {
   "text": "Trời mưa rồi nắng.",
   "lang": "vi"
  },
  {
   "text": "Xuất sắc! Có nắng sau mưa là có cầu vồng.",
   "lang": "vi"
  },
  {
   "text": "Mây kéo đến.",
   "lang": "vi"
  },
  {
   "text": "Trời đổ mưa.",
   "lang": "vi"
  },
  {
   "text": "Mưa tạnh, nắng lên.",
   "lang": "vi"
  },
  {
   "text": "Cầu vồng hiện ra.",
   "lang": "vi"
  },
  {
   "text": "Tối rồi, mình giữ sạch người nhé!",
   "lang": "vi"
  },
  {
   "text": "Giỏi quá! Bé biết giữ sạch người rồi.",
   "lang": "vi"
  },
  {
   "text": "Đánh răng: bé dùng gì trước?",
   "lang": "vi"
  },
  {
   "text": "Rửa tay: bé dùng gì trước?",
   "lang": "vi"
  },
  {
   "text": "Giỏi quá! Tay sạch thơm rồi.",
   "lang": "vi"
  },
  {
   "text": "Làm ướt tay dưới vòi nước.",
   "lang": "vi"
  },
  {
   "text": "Xoa xà phòng thật kỹ.",
   "lang": "vi"
  },
  {
   "text": "Lau khô tay bằng khăn.",
   "lang": "vi"
  },
  {
   "text": "Buổi tối của Mono.",
   "lang": "vi"
  },
  {
   "text": "Tuyệt vời! Ngủ ngon, sáng ra thật khỏe.",
   "lang": "vi"
  },
  {
   "text": "Mono đánh răng.",
   "lang": "vi"
  },
  {
   "text": "Mono nghe kể chuyện.",
   "lang": "vi"
  },
  {
   "text": "Sáng ra, Mono thức dậy.",
   "lang": "vi"
  }
 ]
